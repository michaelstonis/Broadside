<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared helpers for the test projects. A plain library: it overrides the test-project defaults of tests/Directory.Build.props. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <RootNamespace>Broadside.TestSupport</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Broadside/Broadside.csproj" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

</Project>
