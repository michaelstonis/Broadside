<Project>

  <!--
    The CoreGraphics backend's tests (issue #125). They render on macOS only: the project imports the SDK under the same platform
    gate as src/Broadside.Rendering.CoreGraphics (BroadsideBuildPlatformBackends), and targets net10.0-macos alone; the iOS and
    Mac Catalyst builds of the package are checked by building it, not by running tests on a simulator.
  -->
  <PropertyGroup Label="Platform gate">
    <BroadsideBuildPlatformBackends Condition="'$(BroadsideBuildPlatformBackends)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</BroadsideBuildPlatformBackends>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(BroadsideBuildPlatformBackends)' == 'true'" />

  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <ApplicationId>dev.broadside.rendering.coregraphics.tests</ApplicationId>
    <!-- Run the bundle's executable in this process's terminal, not through `open`, so the test platform sees its output and exit code. -->
    <RunWithOpen>false</RunWithOpen>
    <!-- Program.cs is the entry point (see there). -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Broadside.Rendering.CoreGraphics/Broadside.Rendering.CoreGraphics.csproj" />
    <ProjectReference Include="../Broadside.TestSupport/Broadside.TestSupport.csproj" />
    <ProjectReference Include="../Broadside.GoldenImages/Broadside.GoldenImages.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <!-- No-op targets for a host that cannot build this project. The SDK, when imported below, replaces every one of them. -->
  <Target Name="Restore" />
  <Target Name="Build" />
  <Target Name="Rebuild" />
  <Target Name="Clean" />
  <Target Name="Pack" />
  <Target Name="VSTest" />

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(BroadsideBuildPlatformBackends)' == 'true'" />

  <!--
    xUnit v3 insists on a .NET app host, but a macOS app's host is the native launcher inside its bundle (the macOS SDK turns
    UseAppHost off). Replace xUnit's check, which runs nothing else, so the bundle's launcher runs the tests.
  -->
  <Target Name="_XunitValidateBuild" />

</Project>
