<Project>

  <!-- Central package management. Every PackageReference in the repository takes its version from here. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft-shipped, no native component: allowed in the core (ADR 0001)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Backends (never referenced by the core)">
    <PackageVersion Include="SkiaSharp" Version="4.156.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.360" />
  </ItemGroup>

  <ItemGroup Label="Viewer shells: Microsoft-shipped UI frameworks, never referenced by the core (ADR 0001)">
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
  </ItemGroup>

  <!--
    The Uno Platform viewer (#225) uses the Uno.Sdk single-project SDK, an MSBuild SDK: its exact version is pinned in global.json
    ("msbuild-sdks": Uno.Sdk 6.7.49, the newest servicing release of Uno 6.7; Uno 7.0 shipped days ago), not here, because MSBuild
    resolves SDKs before NuGet sees this file. That SDK version fixes Uno.WinUI (6.7.424) and every package it adds implicitly, and
    it honors central package management: it reads these PackageVersion items and adds its own versioned references. The sample's
    heads turn transitive pinning off (see samples/Broadside.Viewer.Uno.Sample), so Uno keeps its own SkiaSharp.
  -->
  <ItemGroup Label="Avalonia viewer (#224): Avalonia's own packages, never referenced by the core (ADR 0001)">
    <!-- The shell library references Avalonia only; Desktop and Fluent are the sample's, Headless and Skia the UI tests'. Avalonia.Skia
         brings its own SkiaSharp (3.119), so the sample and the tests turn off transitive pinning: the SkiaSharp pinned above is the
         Skia backend's, a different major version. -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup Label="Build and analysis">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Tests, benchmarks, fuzzing">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- For libraries shared by test projects: the xunit.v3 core assembly without the executable entry point. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.5.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <!-- Drives a real browser for the Blazor WebAssembly viewer's tests (#221); never in a package. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.58.0" />
    <!-- An independent, fully managed PNG decoder (public domain port of stb_image) that checks the rasterizer's PNG output (#95); never in a package. -->
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <!-- SkiaSharp's native library for Linux (SkiaSharp itself carries only the Windows and Apple ones), so the Skia backend's tests and
         benchmarks run on the Linux CI legs (#121); same version as SkiaSharp, never in a package: an application picks its own. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.1" />
    <!-- The MAUI viewer (#226): MAUI itself and SkiaSharp's MAUI views, the platform libraries ADR 0001 allows that shell. -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="SkiaSharp.Views.Maui.Controls" Version="4.156.1" />
    <!-- The WinUI 3 viewer (#223): the Windows App SDK, the platform library ADR 0001 allows that shell; the version MAUI 10.0.110 uses
         on Windows, so the two shells pin the same one. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <!-- UI Automation client for the WinUI viewer's UI tests on the Windows runner (tests only). -->
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- A concrete container, logging pipeline and configuration for the dependency-injection tests (#46); never in the core. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

</Project>
