<Project>

  <!--
    Platform gate. The Android target framework needs the android workload. The default assumes a macOS host has it,
    which is where the mobile workloads are normally installed together; on any other host the SDK is not imported,
    so the project has no target frameworks and only the no-op targets below, which let a solution build, restore or
    pack walk past it. Force the decision from CI or the command line with -p:BroadsideBuildPlatformBackends=true|false.
    Machines without the workloads build Broadside.Core.slnf.
  -->
  <PropertyGroup Label="Platform gate">
    <BroadsideBuildPlatformBackends Condition="'$(BroadsideBuildPlatformBackends)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</BroadsideBuildPlatformBackends>
  </PropertyGroup>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(BroadsideBuildPlatformBackends)' == 'true'" />

  <PropertyGroup>
    <Description>Android backend for Broadside. Renders display lists through the native Android Canvas API. Depends on the Android bindings shipped with the .NET android workload.</Description>
    <TargetFramework />
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- A Canvas backend has no Android resources; the generated public Resource class would otherwise be unshipped public API. -->
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Broadside.Rendering/Broadside.Rendering.csproj" />
  </ItemGroup>

  <!-- No-op targets for a host that cannot build this project. The SDK, when imported below, replaces every one of them. -->
  <Target Name="Restore" />
  <Target Name="Build" />
  <Target Name="Rebuild" />
  <Target Name="Clean" />
  <Target Name="Pack" />

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="'$(BroadsideBuildPlatformBackends)' == 'true'" />

</Project>
