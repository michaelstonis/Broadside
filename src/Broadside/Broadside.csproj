<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The core of Broadside, a fully managed .NET implementation of ISO 32000-2: the COS object layer, the document model, stream filters, font program parsers, image codecs, the content interpreter, the display list and backend contract, text extraction, the layout tree, logical structure, forms, annotations, security handlers, signatures, canvas writing, diagnostics and dependency-injection registration. No native dependencies.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Memory-mapped file windows (issue #45): spans over the mapping, so parsing a large file copies nothing. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="Third-party notices (issues #49, #61): the AFM terms require MustRead.html to travel with data derived from the AFM files; the IJG licence requires README.ijg with code derived from libjpeg">
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="Fonts/Data/Afm/MustRead.html" Pack="true" PackagePath="licenses/adobe-core14-afm/" />
    <None Include="Fonts/Data/GlyphList/LICENSE.md" Pack="true" PackagePath="licenses/adobe-glyph-list/" />
    <None Include="Fonts/Data/CMaps/LICENSE.md" Pack="true" PackagePath="licenses/adobe-cmap-resources/" />
    <None Include="Filters/Dct/README.ijg" Pack="true" PackagePath="licenses/ijg/" />
  </ItemGroup>

  <!--
    The package ships data and code under other licences besides MIT (APAFML for the AFM metrics, BSD-3-Clause for the Adobe glyph
    list and CMap resources, the IJG licence for the islow IDCT), so its licence is a file, not the MIT expression: the repository's
    LICENSE followed by THIRD-PARTY-NOTICES.txt, joined when the package is built so neither text is duplicated in the repository.
  -->
  <PropertyGroup>
    <PackageLicenseExpression />
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <UsingTask TaskName="BroadsideJoinTextFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Inputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        File.WriteAllText(Output, string.Join("\n\n\n", Inputs.Select(input => File.ReadAllText(input.ItemSpec).Replace("\r\n", "\n").TrimEnd())) + "\n");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="BroadsideWritePackageLicense" BeforeTargets="_GetPackageFiles">
    <BroadsideJoinTextFiles Inputs="$(MSBuildThisFileDirectory)../../LICENSE;$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.txt" Output="$(IntermediateOutputPath)package/LICENSE.txt" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)package/LICENSE.txt" Pack="true" PackagePath="/" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
