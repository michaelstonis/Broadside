<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The core of Broadside, a fully managed .NET implementation of ISO 32000-2: the COS object layer, the document model, stream filters, font program parsers, image codecs, the content interpreter, the display list and backend contract, text extraction, the layout tree, logical structure, forms, annotations, security handlers, signatures, canvas writing, diagnostics and dependency-injection registration. No native dependencies.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Memory-mapped file windows (issue #45): spans over the mapping, so parsing a large file copies nothing. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Label="Third-party data notices (issue #49): the AFM terms require MustRead.html to travel with data derived from the AFM files">
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
    <None Include="Fonts/Data/Afm/MustRead.html" Pack="true" PackagePath="licenses/adobe-core14-afm/" />
    <None Include="Fonts/Data/GlyphList/LICENSE.md" Pack="true" PackagePath="licenses/adobe-glyph-list/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
