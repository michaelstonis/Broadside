<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Direct2D backend for Broadside. Renders display lists through the native Windows Direct2D and DirectWrite APIs, bound at build time with CsWin32 so the package carries no runtime dependency beyond Windows itself.</Description>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- The Windows targeting pack is a NuGet package, so this project builds on every host without a workload. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Broadside.Rendering/Broadside.Rendering.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
