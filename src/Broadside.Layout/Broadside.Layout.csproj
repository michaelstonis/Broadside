<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Flow layout for Broadside: paragraphs broken into lines, aligned and justified, and flowed across pages of a set size and margins through the core's canvas API. A document builder describes documents as nested content in C# and lays them out through the flow engine. Depends only on the Broadside core and its Standard 14 font package. No native dependencies.</Description>
    <RootNamespace>Broadside.Layout.Flow</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Broadside/Broadside.csproj" />
    <!-- The document builder's default fonts: the Liberation programs, managed and embedded, so a default theme always embeds its font. -->
    <ProjectReference Include="../Broadside.Fonts.Standard14/Broadside.Fonts.Standard14.csproj" />
  </ItemGroup>

</Project>
