<?xml version="1.0" encoding="utf-8"?>
<!-- As the WinUI 3 templates write it. The self-contained Windows App SDK build merges its reg-free WinRT entries into this. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Broadside.Viewer.WinUI.Sample.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and later: unpackaged apps need it for OS features (the custom title bar, among others). -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- The newest Windows the app declares it was tested on (its target platform version), for OS behavior keyed on it. -->
      <maxversiontested Id="10.0.19041.0"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
