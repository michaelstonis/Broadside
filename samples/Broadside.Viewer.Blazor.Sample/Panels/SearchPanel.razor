@inherits DemoPanel
@inject IJSRuntime JS

<form class="row" @onsubmit="Search">
  <input @bind="_query" type="search" enterkeyhint="search" placeholder="Find in document" aria-label="Find in document" data-input="search" />
  <button type="submit">Find</button>
</form>
<div class="row">
  <label><input type="checkbox" @bind="_matchCase" data-input="search-case" /> Match case</label>
  <label><input type="checkbox" @bind="_wholeWord" data-input="search-word" /> Whole word</label>
  <label><input type="checkbox" @bind="_matchDiacritics" data-input="search-diacritics" /> Diacritics</label>
</div>

@if (_search is { } search && search.Query.Length > 0)
{
  IReadOnlyList<SearchMatch> matches = search.Matches;
  @if (!search.IsSearchComplete)
  {
    <p class="hint">Searching… @search.SearchedPageCount of @search.Session.PageCount pages</p>
  }

  @if (matches.Count > 0)
  {
    <div class="row between">
      <span data-search-count="@matches.Count">@(search.CurrentIndex + 1) of @matches.Count@(search.IsSearchComplete ? "" : "+")</span>
      <span>
        <button class="icon" @onclick="() => Reveal(search.Previous())" aria-label="Previous match">‹</button>
        <button class="icon" @onclick="() => Reveal(search.Next())" aria-label="Next match">›</button>
        <button @onclick="CopyAsync">Copy</button>
      </span>
    </div>
    <ul class="list results">
      @for (int i = 0; i < matches.Count && i < 200; i++)
      {
        int index = i;
        SearchMatch match = matches[i];
        <li>
          <button class="list-item @(index == search.CurrentIndex ? "current" : "")" @onclick="() => Reveal(search.MoveTo(index))">
            <small>Page @(match.PageIndex + 1)</small>
            <span>@match.Context</span>
          </button>
        </li>
      }
    </ul>
  }
  else if (search.IsSearchComplete)
  {
    <p class="hint" data-search-count="0">No matches.</p>
  }
}
else
{
  <p class="hint">The viewer indexes each page's words in the background (in slices between frames in the browser) and highlights every
    match over the pages without drawing them again; results arrive while the rest of the document is still being indexed.</p>
}

@if (_copied is not null)
{
  <p class="hint">Copied: “@_copied”</p>
}

@code {
  private string _query = "";
  private bool _matchCase;
  private bool _wholeWord;
  private bool _matchDiacritics;
  private string? _copied;
  private DocumentSearch? _search;
  private bool _revealFirst;

  protected override Task OnDemoChangedAsync()
  {
    DocumentSearch? search = Demo.Viewer?.Search;
    if (!ReferenceEquals(search, _search))
    {
      _search?.Changed -= OnSearchChanged;
      _search = search;
      _search?.Changed += OnSearchChanged;
    }

    return Task.CompletedTask;
  }

  protected override void OnClosed()
  {
    _search?.Changed -= OnSearchChanged;
    _search?.Clear(); // the highlights go with the panel
  }

  private void OnSearchChanged(object? sender, EventArgs e) => _ = InvokeAsync(() =>
  {
    if (_revealFirst && _search?.Current is { } first)
    {
      _revealFirst = false;
      Reveal(first);
    }

    StateHasChanged();
  });

  private void Search()
  {
    _copied = null;
    if (_search is not { } search)
    {
      return;
    }

    _revealFirst = true;
    search.Search(
      _query,
      new TextSearchOptions().WithMatchCase(_matchCase).WithWholeWord(_wholeWord).WithMatchDiacritics(_matchDiacritics),
      Demo.Viewer?.State.PageIndex ?? 0);
  }

  private void Reveal(SearchMatch? match)
  {
    if (match is not null)
    {
      Demo.Viewer?.Reveal(match.PageIndex, match.Bounds);
    }
  }

  private async Task CopyAsync()
  {
    if (_search?.Current is { } current)
    {
      _copied = current.Text;
      try
      {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _copied);
      }
      catch (JSException)
      {
        // The clipboard needs a secure context and a user gesture; the text is still shown.
      }
    }
  }
}
