@inherits DemoPanel

@if (_loading)
{
  <p class="hint">Reading the outline…</p>
}
else if (_outline is null || _outline.IsEmpty)
{
  <p class="hint">This document has no outline (bookmarks). Try “Outline and links” in the gallery.</p>
}
else
{
  <ul class="tree outline" role="tree">
    @foreach (OutlineEntry entry in _outline.Roots)
    {
      @Item(entry, 0)
    }
  </ul>
}

@code {
  private DocumentOutline? _outline;
  private bool _loading;
  private int _version = -1;
  private readonly HashSet<int> _open = [];

  protected override Task OnDemoChangedAsync()
  {
    if (_version != Demo.Version)
    {
      _version = Demo.Version;
      _ = LoadAsync(_version);
    }

    return Task.CompletedTask;
  }

  // The outline is the viewer core's model (DocumentOutline): destinations are resolved to view positions when it loads, off the UI
  // thread, and the same entry's target goes to PdfViewer.GoTo.
  private async Task LoadAsync(int version)
  {
    _open.Clear();
    _outline = null;
    if (Demo.Session is not { } session)
    {
      return;
    }

    _loading = true;
    try
    {
      DocumentOutline outline = await DocumentOutline.ReadAsync(session, Demo.WorkToken);
      if (version == _version)
      {
        _outline = outline;
        _open.UnionWith(outline.Entries.Where(entry => entry.IsOpen).Select(entry => entry.Id));
      }
    }
    catch (OperationCanceledException)
    {
    }
    catch (ObjectDisposedException)
    {
    }
    finally
    {
      if (version == _version)
      {
        _loading = false;
      }

      await InvokeAsync(StateHasChanged);
    }
  }

  // Children render only once a node is expanded, so a huge outline costs nothing until it is browsed.
  private RenderFragment Item(OutlineEntry entry, int depth) => __builder =>
  {
    bool hasChildren = entry.Children.Count > 0;
    bool open = _open.Contains(entry.Id);
    string style = Style(entry);
    <li role="treeitem" aria-expanded="@(hasChildren ? (open ? "true" : "false") : null)">
      <div class="tree-row" style="padding-left: @(depth * 14)px">
        @if (hasChildren)
        {
          <button class="icon small" @onclick="() => Toggle(entry)" aria-label="@(open ? "Collapse" : "Expand")">@(open ? "▾" : "▸")</button>
        }
        else
        {
          <span class="tree-spacer"></span>
        }
        <button class="tree-label" @onclick="() => Go(entry)" disabled="@(entry.Target is null)" data-outline="@entry.Title" style="@style">
          @entry.Title
          @if (entry.PageLabel is { } label)
          {
            <small>p. @label</small>
          }
        </button>
      </div>
      @if (hasChildren && open)
      {
        <ul role="group">
          @foreach (OutlineEntry child in entry.Children)
          {
            @Item(child, depth + 1)
          }
        </ul>
      }
    </li>
  };

  // The file's look for the item (Table 151: C color, F bold and italic); black, the default, leaves the theme's own color.
  private static string Style(OutlineEntry entry)
  {
    string style = (entry.IsBold ? "font-weight: 700;" : "") + (entry.IsItalic ? "font-style: italic;" : "");
    PdfRgbColor color = entry.Color;
    if (color.Red + color.Green + color.Blue > 0)
    {
      style += FormattableString.Invariant($"color: rgb({Math.Round(color.Red * 255)}, {Math.Round(color.Green * 255)}, {Math.Round(color.Blue * 255)});");
    }

    return style;
  }

  private void Toggle(OutlineEntry entry)
  {
    if (!_open.Remove(entry.Id))
    {
      _open.Add(entry.Id);
    }
  }

  // The viewer goes where the destination says (its page, view and zoom); an address is the host's business, never opened here.
  private void Go(OutlineEntry entry)
  {
    if (entry.Target is { } target)
    {
      Demo.Viewer?.GoTo(target);
    }
  }
}
