<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The Broadside Blazor WebAssembly demo (issues #221 and #338). `dotnet run` serves it in debug (interpreted); `dotnet publish -c Release`
    trims it and compiles it ahead of time to WebAssembly, which needs the wasm-tools workload (`dotnet workload install wasm-tools`).
    The published wwwroot is a self-contained static site that works from any sub-path (relative base href): publish-static.sh copies
    it to a folder. It carries no native binaries beyond the .NET WebAssembly runtime and stays under the size budget the browser
    tests check (tests/Broadside.Viewer.Blazor.BrowserTests/PublishedAppTests.cs). See README.md.

    Publish switches:
      -p:BroadsideAot=false               no ahead-of-time compilation: the IL runs in the interpreter, the runtime module is ~1.3 MB
                                          instead of ~21 MB, and no file is larger than ~4.5 MB (hosts with a per-file size limit).
      -p:BroadsideAot=hot                 ahead-of-time compilation of only the methods a recorded viewing session ran (the AOT
                                          profiles hot-aot*.aotprofile), optimized for size; the rest runs in the interpreter. A
                                          runtime module of 11.1 MiB instead of ~24.5 MB (issues #365, #547); see README.md.
      -p:BroadsideAot=profiler            no ahead-of-time compilation, with Mono's AOT profiler: the build that records those
                                          profiles (issue #547).
      -p:BroadsideRuntimeFolder=<name>    moves _framework to <name> and _content to <name>-content after publishing (hosts that
                                          reserve paths starting with "_"); index.html is rewritten to load from there (see README.md).
  -->
  <PropertyGroup>
    <TimeZoneSupport>false</TimeZoneSupport>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <!-- A plain static site: the host serves files as they are, so no precompressed .br/.gz copies. -->
    <CompressionEnabled>false</CompressionEnabled>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- [JSExport] benchmark hooks (RenderStats) need the generated interop's unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BroadsideAot Condition="'$(BroadsideAot)' == ''">true</BroadsideAot>
    <!--
      BroadsideAot=hot: the AOT profiles of a viewing session (issue #547), which list the methods compiled ahead of time; every other
      method is interpreted. AotProfileTests (tests/Broadside.Viewer.Blazor.BrowserTests) records them; see README.md.
    -->
    <BroadsideAotProfile Condition="'$(BroadsideAotProfile)' == ''">$(MSBuildThisFileDirectory)hot-aot.aotprofile;$(MSBuildThisFileDirectory)hot-aot-worker.aotprofile</BroadsideAotProfile>
    <!-- The document builder (#397) is experimental until 1.1. -->
    <NoWarn>$(NoWarn);BROADSIDE0001</NoWarn>
  </PropertyGroup>

  <!-- The WebAssembly SDK publishes in a nested build that clears _IsPublishing and sets _WasmIsPublishing instead. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' Or '$(_WasmIsPublishing)' == 'true'">
    <RunAOTCompilation Condition="'$(BroadsideAot)' == 'true' Or '$(BroadsideAot)' == 'hot'">true</RunAOTCompilation>
    <EmccCompileOptimizationFlag Condition="'$(BroadsideAot)' == 'hot'">-Oz</EmccCompileOptimizationFlag>
    <EmccLinkOptimizationFlag Condition="'$(BroadsideAot)' == 'hot'">-Oz</EmccLinkOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag Condition="'$(BroadsideAot)' == 'hot'">-Oz</WasmBitcodeCompileOptimizationFlag>
    <WasmAotProfilePath Condition="'$(BroadsideAot)' == 'hot'">$(BroadsideAotProfile)</WasmAotProfilePath>
    <!--
      With a profile, generic instances collected into the shared aot-instances module are left half compiled: compiled code that
      calls one the session did not record throws NotImplementedException (issue #547). Without that module each assembly keeps
      the instances it uses, and the module is smaller too.
    -->
    <WasmDedup Condition="'$(BroadsideAot)' == 'hot'">false</WasmDedup>
    <WasmProfilers Condition="'$(BroadsideAot)' == 'profiler'">aot</WasmProfilers>
    <EnableDiagnostics Condition="'$(BroadsideAot)' == 'profiler'">false</EnableDiagnostics>
    <WasmBuildNative Condition="'$(BroadsideAot)' == 'profiler'">true</WasmBuildNative>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!--
    BroadsideAot=hot: the WebAssembly SDK compiles an assembly ahead of time again only when the assembly is newer than its compiled
    output, so a re-recorded profile would not apply. When a profile is newer than the last compilation, its output is deleted.
  -->
  <Target Name="BroadsideRecompileWithNewProfiles" BeforeTargets="_WasmAotCompileApp" Condition="'$(BroadsideAot)' == 'hot'"
          Inputs="$(BroadsideAotProfile)" Outputs="$(_WasmIntermediateOutputPath)broadside-aot-profiles.stamp">
    <ItemGroup>
      <_BroadsideAotOutputs Include="$(_WasmIntermediateOutputPath)*.bc" />
    </ItemGroup>
    <Delete Files="@(_BroadsideAotOutputs)" />
    <Touch Files="$(_WasmIntermediateOutputPath)broadside-aot-profiles.stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Broadside.Viewer.Blazor/Broadside.Viewer.Blazor.csproj" />
    <ProjectReference Include="../../src/Broadside.Layout/Broadside.Layout.csproj" />
    <ProjectReference Include="../../src/Broadside.Fonts.Standard14/Broadside.Fonts.Standard14.csproj" />
  </ItemGroup>

  <!--
    The browser kernel benchmark (KernelBenchmarks.cs, #470): SIMD kernels are linked as source, so the sample sees no internals.
  -->
  <ItemGroup>
    <Compile Include="../../tests/Broadside.TestSupport/SpanKernel.cs;../../tests/Broadside.TestSupport/SimdExampleKernel.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside/Images/PixelPacking.cs;../../src/Broadside/Graphics/Colors/GrayExpansion.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside/Filters/Dct/JpegColor.cs;../../src/Broadside/Filters/Dct/JpegColor.Vector128.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside/Filters/Dct/InverseDct.cs;../../src/Broadside/Filters/Dct/InverseDct.Vector128.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside.Rendering/CompositingRows.cs;../../src/Broadside.Rendering/BoxFilter.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside/Graphics/Colors/CmykCharacterization.cs;../../src/Broadside/Graphics/Colors/CmykCharacterization.Vector128.cs" LinkBase="Kernels" />
    <Compile Include="../../src/Broadside/Filters/Jpx/JpxLifting.cs;../../src/Broadside/Filters/Jpx/JpxLifting.Vector128.cs;../../src/Broadside/Filters/Jpx/JpxLevelShift.cs;../../src/Broadside/Filters/Jpx/JpxLevelShift.Vector128.cs" LinkBase="Kernels" />
  </ItemGroup>

  <!--
    The gallery: the representative sample documents (samples/documents/pdf, #363) and hand-written files from the test corpus, served
    from wwwroot/documents (linked, so they never drift).
  -->
  <ItemGroup>
    <Content Include="../documents/pdf/*.pdf" Link="wwwroot/documents/%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
    <Content Include="../../tests/Corpus/layout-two-column-tagged.pdf;../../tests/Corpus/layout-tables.pdf;../../tests/Corpus/tagged-structure.pdf;../../tests/Corpus/outline-full.pdf;../../tests/Corpus/annotations-link.pdf;../../tests/Corpus/acroform-fields.pdf;../../tests/Corpus/info-dictionary.pdf;../../tests/Corpus/shading-radial-cases.pdf;../../tests/Corpus/transparency-blend-modes.pdf;../../tests/Corpus/page-rotation.pdf;../../tests/Corpus/linearized.pdf"
             Link="wwwroot/documents/%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Hosts that reserve paths starting with "_" (some static hosts treat them as private): after publishing, move the runtime and the
    component libraries' assets to folders without the underscore and point index.html at them. The runtime loads every other file
    relative to dotnet.js (wwwroot/js/start.js maps it through Blazor's loadBootResource), and an import map sends the viewer's
    JavaScript module import from _content to the renamed folder.
  -->
  <Target Name="BroadsideMoveRuntimeFolder" AfterTargets="Publish" Condition="'$(BroadsideRuntimeFolder)' != '' And '$(_WasmIsPublishing)' != 'true'">
    <Error Condition="$(BroadsideRuntimeFolder.StartsWith('_')) Or $(BroadsideRuntimeFolder.Contains('/')) Or $(BroadsideRuntimeFolder.Contains('\'))"
           Text="BroadsideRuntimeFolder must be a plain folder name that does not start with an underscore." />
    <PropertyGroup>
      <_BroadsideSite>$([MSBuild]::NormalizeDirectory('$(PublishDir)', 'wwwroot'))</_BroadsideSite>
      <_BroadsideContent>$(BroadsideRuntimeFolder)-content</_BroadsideContent>
    </PropertyGroup>
    <ItemGroup>
      <_BroadsideFramework Include="$(_BroadsideSite)_framework/**/*" />
      <_BroadsideContentFiles Include="$(_BroadsideSite)_content/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BroadsideFramework)" DestinationFiles="@(_BroadsideFramework->'$(_BroadsideSite)$(BroadsideRuntimeFolder)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_BroadsideContentFiles)" DestinationFiles="@(_BroadsideContentFiles->'$(_BroadsideSite)$(_BroadsideContent)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <RemoveDir Directories="$(_BroadsideSite)_framework;$(_BroadsideSite)_content" />
    <PropertyGroup>
      <_BroadsideIndex>$([System.IO.File]::ReadAllText('$(_BroadsideSite)index.html'))</_BroadsideIndex>
      <_BroadsideIndex>$(_BroadsideIndex.Replace('src="_framework/', 'src="$(BroadsideRuntimeFolder)/'))</_BroadsideIndex>
      <_BroadsideIndex>$(_BroadsideIndex.Replace('&lt;!-- broadside:import-map --&gt;', '&lt;script type="importmap"&gt;{ "imports": { "./_content/": "./$(_BroadsideContent)/" } }&lt;/script&gt;'))</_BroadsideIndex>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BroadsideSite)index.html" Lines="$([MSBuild]::Escape('$(_BroadsideIndex.TrimEnd())'))" Overwrite="true" WriteOnlyWhenDifferent="false" />
    <Message Importance="high" Text="Runtime moved to $(BroadsideRuntimeFolder)/ and component assets to $(_BroadsideContent)/ in $(_BroadsideSite)" />
  </Target>

</Project>
