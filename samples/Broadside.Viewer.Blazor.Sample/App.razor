@implements IDisposable
@inject Demo Demo
@inject NavigationManager Navigation

<div class="app">
  <header class="topbar">
    <button class="icon" @onclick="() => Toggle(Panel.Open)" aria-label="Documents" aria-expanded="@(_panel == Panel.Open ? "true" : "false")" data-panel-button="open">☰</button>
    <div class="title" title="@Demo.Name">
      <span class="name">@(Demo.Name.Length == 0 ? "Broadside" : Demo.Name)</span>
      @if (Demo.IsEdited)
      {
        <span class="edited" title="Edited">edited</span>
      }
    </div>
    <div class="pager">
      <button class="icon" @onclick="() => Demo.Viewer?.PreviousPage()" aria-label="Previous page">‹</button>
      <span class="page" aria-live="polite" data-page="@Demo.State.PageIndex">@(Demo.State.PageCount == 0 ? "–" : $"{Demo.State.PageIndex + 1} / {Demo.State.PageCount}")</span>
      <button class="icon" @onclick="() => Demo.Viewer?.NextPage()" aria-label="Next page">›</button>
    </div>
    <div class="zoom wide-only">
      <button class="icon" @onclick="() => Demo.Viewer?.ZoomBy(1 / 1.25)" aria-label="Zoom out">−</button>
      <span class="percent">@((Demo.State.Zoom * 100).ToString("0", CultureInfo.InvariantCulture))%</span>
      <button class="icon" @onclick="() => Demo.Viewer?.ZoomBy(1.25)" aria-label="Zoom in">+</button>
      <button class="icon" @onclick="() => Demo.Viewer?.ZoomTo(ZoomMode.FitWidth)" aria-label="Fit width">↔</button>
    </div>
    <button class="icon" @onclick="() => Demo.DownloadAsync()" disabled="@(Demo.Document is null)" aria-label="Download the document with your edits" data-action="download">⤓</button>
  </header>

  @if (Demo.Link is not null)
  {
    @* A link out of the document is never followed by itself: the user confirms it here. *@
    <div class="message link-sheet" role="alertdialog" aria-label="Open link" data-link-sheet>
      <span>@Demo.Message <strong class="link-address">@Demo.Link</strong></span>
      <a class="link-open" href="@Demo.Link" target="_blank" rel="noopener noreferrer" @onclick="() => Demo.Report(null)">Open</a>
      <button class="link-cancel" @onclick="() => Demo.Report(null)">Cancel</button>
    </div>
  }
  else if (Demo.Message is not null)
  {
    <div class="message" role="status">
      <span>@Demo.Message</span>
      <button class="icon small" @onclick="() => Demo.Report(null)" aria-label="Dismiss">×</button>
    </div>
  }

  <div class="workspace @(_panel == Panel.None ? "" : "with-sheet")">
    <main class="stage">
      @if (Demo.Session is not null)
      {
        <PdfViewer @ref="_viewer" Class="viewer" Session="Demo.Session" Label="@Demo.Name" LayoutOptions="_layout"
                   ShowAnnotations="_showAnnotations" AllowAnnotationEditing="_editAnnotations"
                   OnStateChanged="OnStateChanged" OnAction="OnAction" OnError="OnError" TileObserver="RenderStats.Observe" />
      }
      else
      {
        <div class="empty">@(Demo.IsOpening ? "Opening…" : "Open a document from the menu.")</div>
      }
    </main>

    @if (_panel != Panel.None)
    {
      <aside class="sheet" role="dialog" aria-label="@Title(_panel)" data-sheet="@_panel.ToString().ToLowerInvariant()" @onkeydown="SheetKey">
        <div class="sheet-handle" aria-hidden="true"></div>
        <div class="sheet-header">
          <h2>@Title(_panel)</h2>
          <button class="icon" @onclick="() => Toggle(Panel.None)" aria-label="Close panel">×</button>
        </div>
        <div class="sheet-body">
          @switch (_panel)
          {
            case Panel.Open:
              <OpenPanel />
              break;
            case Panel.Search:
              <SearchPanel />
              break;
            case Panel.Outline:
              <OutlinePanel />
              break;
            case Panel.Pages:
              <PagesPanel />
              break;
            case Panel.Annotate:
              <AnnotatePanel @bind-ShowAnnotations="_showAnnotations" @bind-EditAnnotations="_editAnnotations" />
              break;
            case Panel.Form:
              <FormPanel />
              break;
            case Panel.Info:
              <InfoPanel />
              break;
            case Panel.Signatures:
              <SignaturesPanel />
              break;
            case Panel.View:
              <ViewPanel Layout="_layout" LayoutChanged="layout => _layout = layout" />
              break;
            case Panel.Create:
              <CreatePanel />
              break;
          }
        </div>
      </aside>
    }
  </div>

  <nav class="tabs" aria-label="Tools">
    @foreach (Panel panel in Tabs)
    {
      <button class="tab @(_panel == panel ? "active" : "")" @onclick="() => Toggle(panel)" aria-pressed="@(_panel == panel ? "true" : "false")"
              data-panel-button="@panel.ToString().ToLowerInvariant()">
        <span class="glyph" aria-hidden="true">@Glyph(panel)</span>
        <span class="label">@Title(panel)</span>
      </button>
    }
  </nav>
</div>

@code {
  private enum Panel { None, Open, Search, Outline, Pages, Annotate, Form, Info, Signatures, View, Create }

  private static readonly Panel[] Tabs =
    [Panel.Search, Panel.Outline, Panel.Pages, Panel.Annotate, Panel.Form, Panel.Info, Panel.Signatures, Panel.View, Panel.Create];

  private PdfViewer? _viewer;
  private AnnotationLayer? _layer;
  private AnnotationTarget? _focusedField;
  private Panel _panel;
  private PageLayoutOptions _layout = new();
  private bool _showAnnotations = true;
  private bool _editAnnotations;

  private static string Title(Panel panel) => panel switch
  {
    Panel.Open => "Documents",
    Panel.Search => "Search",
    Panel.Outline => "Outline",
    Panel.Pages => "Pages",
    Panel.Annotate => "Annotate",
    Panel.Form => "Form",
    Panel.Info => "Info",
    Panel.Signatures => "Signatures",
    Panel.View => "View",
    Panel.Create => "Create",
    _ => "",
  };

  private static string Glyph(Panel panel) => panel switch
  {
    Panel.Search => "⌕",
    Panel.Outline => "≡",
    Panel.Pages => "▦",
    Panel.Annotate => "✎",
    Panel.Form => "☐",
    Panel.Info => "i",
    Panel.Signatures => "✓",
    Panel.View => "⟳",
    Panel.Create => "+",
    _ => "",
  };

  protected override async Task OnInitializedAsync()
  {
    Demo.Changed += OnDemoChanged;
    Demo.Current = Demo;

    // ?file=<address> opens a document through range requests (relative addresses resolve against the app, wherever it is hosted).
    string? file = null;
    foreach (string pair in new Uri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
    {
      string[] parts = pair.Split('=', 2);
      if (parts.Length == 2 && parts[0] == "file")
      {
        file = Uri.UnescapeDataString(parts[1]);
      }
      else if (parts.Length == 2 && parts[0] == "renderer" && parts[1] == "webgl")
      {
        // ?renderer=webgl draws with WebGL 2 from the first page (the View panel switches later).
        await Renderers.SetAsync(true);
      }
    }

    if (file is not null)
    {
      await Demo.OpenUrlAsync(file);
    }
    else
    {
      await Demo.OpenGalleryAsync(Demo.Gallery[0]);
    }
  }

  protected override void OnAfterRender(bool firstRender)
  {
    Demo.Viewer = _viewer;
    AnnotationLayer? layer = _viewer?.Annotations;
    if (!ReferenceEquals(layer, _layer))
    {
      _layer?.Changed -= OnLayerChanged;
      _layer = layer;
      _layer?.Changed += OnLayerChanged;
    }
  }

  public void Dispose()
  {
    Demo.Changed -= OnDemoChanged;
    _layer?.Changed -= OnLayerChanged;
  }

  // Tapping a text or choice field in the page opens the Form panel, where the phone's keyboard can fill it.
  private void OnLayerChanged(object? sender, EventArgs e)
  {
    AnnotationTarget? focused = _layer?.FocusedField is Broadside.Forms.PdfTextField or Broadside.Forms.PdfChoiceField ? _layer.Focused : null;
    if (focused is not null && focused != _focusedField && _panel != Panel.Form)
    {
      _panel = Panel.Form;
      _ = InvokeAsync(StateHasChanged);
    }

    _focusedField = focused;
  }

  private void OnDemoChanged(object? sender, EventArgs e)
  {
    // A gallery file whose feature lives in a panel (an outline, a link) opens that panel (#351).
    if (Demo.SuggestedPanel is { } suggested && Enum.TryParse(suggested, ignoreCase: true, out Panel panel))
    {
      Demo.SuggestedPanel = null;
      _panel = panel;
    }

    _ = InvokeAsync(StateHasChanged);
  }

  private void Toggle(Panel panel) => _panel = _panel == panel ? Panel.None : panel;

  private void SheetKey(KeyboardEventArgs e)
  {
    if (e.Key == "Escape")
    {
      _panel = Panel.None;
    }
  }

  private void OnStateChanged(PdfViewerState state)
  {
    Demo.State = state;
    Demo.Refresh();
  }

  // The viewer follows links inside the document itself and never opens anything else: a URI is offered here for the user to open.
  private void OnAction(ViewerActionEventArgs action)
  {
    if (action.Uri is { } uri)
    {
      Demo.Report("This link leaves the document. Open", uri.ToString());
    }
    else if (action.Destination is null && action.PageIndex is null)
    {
      Demo.Report($"The document asked for an action: {action.Kind}");
    }

    // A destination inside the document needs no message: the viewer has already scrolled to it.
  }

  private void OnError(Exception exception) => Demo.Report(exception.Message);
}
