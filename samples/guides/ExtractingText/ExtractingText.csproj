<Project Sdk="Microsoft.NET.Sdk">

  <!-- The text extraction guide (site/articles/extracting-text.md): text with positions, reading order and the layout tree. -->
  <PropertyGroup>
    <AssemblyName>Broadside.Samples.ExtractingText</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Broadside/Broadside.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(CorpusDirectory)text-standard14.pdf" Link="text-standard14.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)layout-two-column-tagged.pdf" Link="layout-two-column-tagged.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)layout-two-column-untagged.pdf" Link="layout-two-column-untagged.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)layout-tables.pdf" Link="layout-tables.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)text-lines-rotated.pdf" Link="text-lines-rotated.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)compare-old.pdf" Link="compare-old.pdf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CorpusDirectory)compare-new.pdf" Link="compare-new.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
